{
  "name": "@qq540491950/dsh-skill-manager",
  "version": "0.2.1",
  "description": "DSH 插件：在设置面板加一页「Skills」，按项目 / 全局 / 自定义 / 随包内置分组浏览 skill，并给每一行一个启用/关闭开关。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "skills",
    "settings"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qq540491950/dsh-skill-manager.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/host/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/host/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "icon": "./assets/icon.svg",
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "assets/icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "engines": {
    "node": ">=22.18",
    "dsh": "^0.2.0-rc.2"
  },
  "scripts": {
    "build": "node tools/build.ts",
    "typecheck": "tsc -b --clean && tsc -b && tsc -p tsconfig.tools.json",
    "verify": "node tools/verify.ts",
    "check": "npm run typecheck && npm run build && npm run verify"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "~18.3.1",
    "esbuild": "^0.28.2",
    "typescript": "~5.9.3"
  }
}
