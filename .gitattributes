# 让 Git 自动识别文本，并在**仓库内统一使用 LF**。
# 本仓库所有文件都是 LF；一旦混入 CRLF，Windows/Linux 之间会产生整文件 diff。
* text=auto eol=lf

# 明确文本类型（本插件只有这几类源文件）
*.js     text eol=lf
*.cjs    text eol=lf
*.mjs    text eol=lf
*.json   text eol=lf
*.md     text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.css    text eol=lf

# 二进制：不做行尾转换，也不尝试文本 diff
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.webp   binary
*.ico    binary
*.icns   binary
*.zip    binary
*.tgz    binary

# Windows 批处理必须保留 CRLF，否则 cmd 可能解析异常
*.bat    text eol=crlf
*.cmd    text eol=crlf
*.ps1    text eol=crlf
